# ============================================================
# Roobird — Environment Variables
# Copy to .env.local for local development
# Add each variable to Vercel for production
# NEVER commit .env.local or any file with real secrets
# ============================================================

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only; bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Robinhood Stock Token API ─────────────────────────────
# Optional override. The app defaults to the public endpoint below.
ROBINHOOD_API_BASE_URL=https://api.robinhood.com/rhj

# ── Scheduled market sync ─────────────────────────────────
# Server-only. Configure the same value in cron-job.org:
# Authorization: Bearer <SYNC_SECRET>
SYNC_SECRET=generate_a_long_random_secret

# ── Market Pulse ──────────────────────────────────────────
# Server-only xAI key used by /api/v1/pulse/[symbol].
XAI_API_KEY=xai-...

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── API key signing ───────────────────────────────────────
# Server-only. Generate with: openssl rand -hex 32
API_KEY_SECRET=your_secret_here

# ── Analytics (optional) ──────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
