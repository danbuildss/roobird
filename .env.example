# ============================================================
# Roobird — Environment Variables
# Copy to .env.local for local development
# Add each variable to Vercel dashboard for production
# NEVER commit .env.local or any file with real secrets
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# Public URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon key (safe to expose in browser — RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key (NEVER expose client-side — bypasses RLS)
# Used only in server-side API routes and migrations
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Robinhood Stock Token API ──────────────────────────────
# Public, read-only, no key required.
# Docs: https://docs.robinhood.com/chain/stock-token-apis/
ROBINHOOD_API_BASE_URL=https://api.robinhood.com/rhj

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── API Key signing ───────────────────────────────────────
# Secret used to generate Roobird API key prefixes
# Generate with: openssl rand -hex 32
API_KEY_SECRET=your_secret_here

# ── Analytics (optional) ──────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
